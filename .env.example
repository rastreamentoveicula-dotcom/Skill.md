# Supabase project settings (required to enable real authentication and persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production integrations (never expose secrets to the browser)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
APP_URL=http://localhost:3000
STORAGE_BUCKET=motion-media
# Chave mestra AES-256-GCM (base64 de 32 bytes: openssl rand -base64 32). Usada para o token do Mercado Pago.
# NÃO troque depois de salvar segredos: eles ficariam ilegíveis. Nunca use prefixo NEXT_PUBLIC_.
AI_SECRETS_ENCRYPTION_KEY=
# Opcional: modelo Gemini padrão (a chave principal dos provedores é cadastrada em /admin/ai e guardada no Supabase Vault)
GEMINI_MODEL=gemini-2.5-flash
